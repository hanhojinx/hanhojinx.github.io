---
import { languageFromPath, languageSwitchPath } from "../lib/i18n";
const lang = languageFromPath(Astro.url.pathname);
const nextLang = lang === "ko" ? "en" : "ko";
---
<div class="site-controls">
  <button class="toggle-control theme-toggle" type="button" role="switch" aria-checked="true" aria-label={lang === "ko" ? "라이트 모드" : "Light mode"}>
    <span class="left-label">{lang === "ko" ? "다크" : "Dark"}</span>
    <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
    <span class="right-label">{lang === "ko" ? "라이트" : "Light"}</span>
  </button>
  <a class:list={["toggle-control", "language-toggle", { "is-right": lang === "en" }]}
    href={languageSwitchPath(Astro.url.pathname, nextLang)}
    aria-label={lang === "ko" ? "영어 버전으로 전환" : "Switch to Korean"} hreflang={nextLang}>
    <span class="left-label" lang="en">KOR</span>
    <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
    <span class="right-label" lang="en">ENG</span>
  </a>
</div>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  function syncTheme() {
    toggle?.setAttribute("aria-checked", String(document.documentElement.dataset.theme !== "dark"));
  }
  toggle?.addEventListener("click", () => {
    const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem("color-theme", theme); } catch {}
    syncTheme();
  });
  window.addEventListener("pageshow", syncTheme);
  window.addEventListener("storage", event => {
    if (event.key === "color-theme") {
      document.documentElement.dataset.theme = event.newValue === "dark" ? "dark" : "light";
      syncTheme();
    }
  });
  syncTheme();
</script>
<style>
  .site-controls { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem 1.75rem; margin-inline: auto; padding-top: 1.25rem; width: min(calc(100% - 3rem), var(--content-width)); }
  .toggle-control { display: inline-flex; align-items: center; justify-content: center; gap: 0.625rem; min-height: 44px; padding: 0; border: 0; background: transparent; color: var(--color-text-secondary); cursor: pointer; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 500; line-height: 1.4; text-decoration: none; white-space: nowrap; }
  .toggle-track { display: inline-block; position: relative; flex: 0 0 auto; width: 52px; height: 28px; border: 2px solid #f7941d; border-radius: 999px; background: var(--color-code-bg); }
  .toggle-thumb { position: absolute; top: 3px; left: 3px; width: 26px; height: 18px; border-radius: 999px; background: #f7941d; transition: transform 180ms ease; }
  .theme-toggle .toggle-thumb, .language-toggle.is-right .toggle-thumb { transform: translateX(16px); }
  :global(html[data-theme="dark"]) .theme-toggle .toggle-thumb { transform: translateX(0); }
  .theme-toggle .right-label, .language-toggle.is-right .right-label, .language-toggle:not(.is-right) .left-label { color: var(--color-text); font-weight: 600; }
  :global(html[data-theme="dark"]) .theme-toggle .right-label { color: var(--color-text-secondary); font-weight: 500; }
  :global(html[data-theme="dark"]) .theme-toggle .left-label { color: var(--color-text); font-weight: 600; }
  .toggle-control:hover .toggle-track { box-shadow: 0 0 0 3px rgb(247 148 29 / 15%); }
  .toggle-control:focus-visible { outline: 2px solid var(--color-text); outline-offset: 4px; border-radius: 4px; }
  @media (max-width: 760px) {
    .site-controls { width: min(calc(100% - 2.5rem), 42.5rem); padding-top: 0.75rem; column-gap: 1rem; }
    .toggle-control { font-size: 0.6875rem; gap: 0.375rem; }
  }
</style>
