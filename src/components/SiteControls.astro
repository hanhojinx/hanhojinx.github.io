---
import { languageFromPath, languageSwitchPath } from "../lib/i18n";
const lang = languageFromPath(Astro.url.pathname);
const nextLang = lang === "ko" ? "en" : "ko";
const themeLabel = lang === "ko" ? "다크 모드로 전환" : "Switch to dark mode";
const languageLabel = lang === "ko" ? "영어 버전으로 전환" : "Switch to Korean";
---
<div class="site-controls">
  <button class="round-control theme-toggle" type="button" aria-label={themeLabel} title={themeLabel}>
    <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.5 14.1A8.6 8.6 0 0 1 9.9 3.5a8.6 8.6 0 1 0 10.6 10.6Z" />
    </svg>
    <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
  </button>
  <a class="round-control language-toggle"
    href={languageSwitchPath(Astro.url.pathname, nextLang)}
    aria-label={languageLabel} title={languageLabel} hreflang={nextLang}>
    <span aria-hidden="true">{nextLang === "ko" ? "KO" : "EN"}</span>
  </a>
</div>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  function syncTheme() {
    const dark = document.documentElement.dataset.theme === "dark";
    const korean = document.documentElement.lang === "ko";
    const label = korean
      ? (dark ? "라이트 모드로 전환" : "다크 모드로 전환")
      : (dark ? "Switch to light mode" : "Switch to dark mode");
    toggle?.setAttribute("aria-label", label);
    toggle?.setAttribute("title", label);
  }
  toggle?.addEventListener("click", () => {
    const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem("color-theme", theme); } catch {}
    syncTheme();
  });
  window.addEventListener("pageshow", syncTheme);
  window.addEventListener("storage", event => {
    if (event.key === "color-theme" || event.key === null) {
      document.documentElement.dataset.theme = event.newValue === "dark" ? "dark" : "light";
      syncTheme();
    }
  });
  syncTheme();
</script>
<style>
  .site-controls { display: flex; justify-content: flex-end; gap: 0.5rem; margin-inline: auto; padding-top: 1.25rem; width: min(calc(100% - 3rem), var(--content-width)); }
  .round-control { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 44px; width: 44px; height: 44px; padding: 0; border: 1px solid var(--color-border); border-radius: 50%; background: transparent; color: var(--color-text-secondary); cursor: pointer; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em; line-height: 1; text-decoration: none; transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease; -webkit-tap-highlight-color: transparent; }
  .round-control svg { width: 20px; height: 20px; }
  .sun-icon { display: none; }
  :global(html[data-theme="dark"]) .moon-icon { display: none; }
  :global(html[data-theme="dark"]) .sun-icon { display: block; }
  @media (hover: hover) {
    .round-control:hover { background: var(--color-code-bg); border-color: var(--color-text-tertiary); color: var(--color-text); }
  }
  .round-control:active { background: var(--color-code-bg); color: var(--color-text); }
  .round-control:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }
  @media (max-width: 760px) {
    .site-controls { width: min(calc(100% - 2.5rem), 42.5rem); padding-top: 0.75rem; }
  }
</style>
