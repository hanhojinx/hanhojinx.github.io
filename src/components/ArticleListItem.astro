---
import type { CollectionEntry } from "astro:content";
import { estimateReadingTime, formatDate, withBase } from "../lib/format";

interface Props { article: CollectionEntry<"articles"> }
const { article } = Astro.props;
const readingMinutes = estimateReadingTime(article.body ?? "");
---

<article class="article-list-item">
  <p class="date">{formatDate(article.data.publishedAt)}</p>
  <h2><a href={withBase(`/articles/${article.id}/`)}>{article.data.title}</a></h2>
  <p class="description">{article.data.description}</p>
  <p class="meta">{article.data.tags.join(" · ")} · {readingMinutes} min read</p>
</article>

<style>
  .article-list-item { min-width: 0; }
  .article-list-item + .article-list-item { margin-top: 1.875rem; }
  p, h2 { margin: 0; }
  .date { color: var(--color-text-tertiary); font-size: 0.8125rem; line-height: 1.5; }
  h2 { font-size: 1.0625rem; font-weight: 550; letter-spacing: -0.01em; line-height: 1.45; margin-top: 0.3125rem; overflow-wrap: anywhere; }
  h2 a { text-decoration: none; }
  h2 a:hover, h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .description { color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.6; margin-top: 0.3125rem; }
  .meta { color: var(--color-text-tertiary); font-size: 0.8125rem; line-height: 1.5; margin-top: 0.4375rem; }

  @media (max-width: 760px) {
    .date,
    .meta { font-size: 0.875rem; }
    h2 { font-size: 1.1875rem; }
    .description { font-size: 1.03125rem; }
  }
</style>
