---
import { formatDate } from "../lib/format";

interface Props {
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  readingMinutes?: number;
}

const { publishedAt, updatedAt, tags = [], readingMinutes } = Astro.props;
---

<div class="article-meta">
  <span>{formatDate(publishedAt)}</span>
  {readingMinutes && <><span aria-hidden="true">·</span><span>{readingMinutes} min read</span></>}
  {tags.length > 0 && <><span aria-hidden="true">·</span><span>{tags.join(" · ")}</span></>}
</div>
{updatedAt && <p class="updated">Updated {formatDate(updatedAt)}</p>}

<style>
  .article-meta { color: var(--color-text-tertiary); display: flex; flex-wrap: wrap; font-size: 0.8125rem; gap: 0.375rem 0.75rem; line-height: 1.5; margin-top: 1.125rem; }
  .updated { color: var(--color-text-tertiary); font-size: 0.8125rem; margin: 0.375rem 0 0; }

  @media (max-width: 760px) {
    .article-meta,
    .updated { font-size: 0.875rem; }
  }
</style>
