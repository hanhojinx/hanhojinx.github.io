---
import type { MarkdownHeading } from "astro";

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length >= 3 && (
  <nav class="toc" aria-labelledby="toc-title">
    <p id="toc-title">Contents</p>
    <ol>
      {items.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc { border-block: 1px solid var(--color-border-light); margin: 2.5rem 0 3.25rem; padding-block: 1.125rem; }
  .toc p { color: var(--color-text-secondary); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; margin: 0 0 var(--space-2); text-transform: uppercase; }
  ol { display: grid; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  li { font-size: 0.875rem; line-height: 1.65; }
  li.nested { padding-left: var(--space-5); }
  a { color: var(--color-text-secondary); text-decoration: none; }
  a:hover, a:focus-visible { color: var(--text); text-decoration: underline; }

  @media (max-width: 760px) {
    .toc p { font-size: 0.8125rem; }
    li { font-size: 0.9375rem; }
  }
</style>
