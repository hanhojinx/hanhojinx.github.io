---
import "katex/dist/katex.min.css";
import type { MarkdownHeading } from "astro";
import ArticleMeta from "../components/ArticleMeta.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { profile } from "../config/profile";
import { withBase } from "../lib/format";
import CVLayout from "./CVLayout.astro";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  readingMinutes: number;
  headings: MarkdownHeading[];
  canonicalUrl?: string;
}

const { title, description, publishedAt, updatedAt, tags = [], readingMinutes, headings, canonicalUrl } = Astro.props;
---

<CVLayout
  page="article"
  title={`${title} — ${profile.name}`}
  description={description}
  type="article"
  publishedAt={publishedAt}
  canonicalPath={canonicalUrl ?? Astro.url.pathname}
>
  <article class="article-page">
    <header class="article-header">
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <ArticleMeta {publishedAt} {updatedAt} {tags} {readingMinutes} />
    </header>
    <TableOfContents {headings} />
    <div class="prose"><slot /></div>
    <nav class="article-back" aria-label="Article navigation">
      <a href={withBase("/articles/")}>← Articles</a>
    </nav>
  </article>
</CVLayout>

<style>
  .article-header { max-width: 42.5rem; }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.13;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .dek {
    color: var(--color-text-secondary);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0.875rem 0 0;
    max-width: 38.75rem;
  }

  .prose {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.72;
    margin-top: 3.25rem;
    max-width: 42.5rem;
  }

  .article-page :global(.toc) + .prose { margin-top: 0; }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--color-text);
    font-family: var(--font-sans);
    scroll-margin-top: var(--space-8);
  }

  .prose :global(h2) { font-size: 1.5rem; font-weight: 580; letter-spacing: -0.02em; line-height: 1.3; margin: 2.6em 0 0.8em; }
  .prose :global(h3) { font-size: 1.1875rem; font-weight: 580; line-height: 1.4; margin: 2.1em 0 0.65em; }
  .prose :global(h4) { font-size: 1rem; font-weight: 600; line-height: 1.45; margin: 1.8em 0 0.5em; }
  .prose :global(p) { margin: 0 0 1.35em; }

  .prose :global(a) {
    color: var(--color-link);
    overflow-wrap: anywhere;
    text-decoration-color: #a8a8a1;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) { text-decoration-color: currentColor; }
  .prose :global(ul), .prose :global(ol) { margin: 1em 0 1.4em; padding-left: 1.4em; }
  .prose :global(li + li) { margin-top: 0.35em; }
  .prose :global(blockquote) { border-left: 2px solid var(--color-border); color: var(--color-text-secondary); margin: 1.8em 0; padding-left: 1.125rem; }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(:not(pre) > code) { background: var(--color-code-bg); border-radius: var(--radius-xs); font-family: var(--font-mono); font-size: 0.88em; padding: 0.12em 0.3em; }
  .prose :global(pre) { background: var(--color-code-bg) !important; border-radius: 3px; font-size: 0.875rem; line-height: 1.65; margin: 1.8em 0; overflow-x: auto; padding: 1.125rem 1.25rem; }
  .prose :global(pre code) { background: transparent; font-family: var(--font-mono); font-size: inherit; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--color-border-light); margin: 3em 0; }
  .prose :global(table) { border-collapse: collapse; display: block; font-family: var(--font-sans); font-size: 0.875rem; line-height: 1.5; margin: 1.8em 0; max-width: 100%; overflow-x: auto; width: 100%; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--color-border-light); padding: 0.5625rem 0.75rem; text-align: left; vertical-align: top; }
  .prose :global(th) { font-weight: 600; }
  .prose :global(img) { display: block; height: auto; margin: 2em auto; max-width: 100%; width: auto; }
  .prose :global(figure) { margin: 2em 0; }
  .prose :global(figure img) { margin-block: 0 1em; }
  .prose :global(figcaption) { color: var(--color-text-tertiary); font-family: var(--font-sans); font-size: 0.8125rem; line-height: 1.55; margin-bottom: 2em; text-align: center; }
  .prose :global(.footnotes) { border-top: 1px solid var(--color-border-light); color: var(--color-text-secondary); font-family: var(--font-sans); font-size: 0.875rem; line-height: 1.65; margin-top: var(--space-16); padding-top: var(--space-6); }
  .prose :global(sup) { font-size: 0.75em; line-height: 0; vertical-align: super; }
  .prose :global(.katex-display) { margin: 1.8em 0; overflow-x: auto; overflow-y: hidden; }

  .article-back {
    border-top: 1px solid var(--color-border-light);
    display: flex;
    gap: var(--space-6);
    justify-content: space-between;
    margin-top: 4.5rem;
    padding-top: var(--space-6);
  }

  .article-back a { font-size: 0.875rem; text-decoration: none; }
  .article-back a:hover, .article-back a:focus-visible { text-decoration: underline; }

  @media (max-width: 760px) {
    h1 { font-size: clamp(2.125rem, 9vw, 2.35rem); line-height: 1.16; }
    .dek { font-size: 1.125rem; }
    .prose { font-size: 1.125rem; line-height: 1.75; }
    .prose :global(h2) { font-size: 1.5rem; }
    .prose :global(h3) { font-size: 1.25rem; }
    .prose :global(h4) { font-size: 1.0625rem; }
    .prose :global(pre) { margin-inline: -0.5rem; padding-inline: var(--space-4); }
    .prose :global(table) { font-size: 0.9375rem; }
    .prose :global(figcaption) { font-size: 0.875rem; }
    .prose :global(.footnotes) { font-size: 0.9375rem; }
    .article-back a { font-size: 0.9375rem; }
  }
</style>
