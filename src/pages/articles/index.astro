---
import { getCollection } from "astro:content";
import ArticleListItem from "../../components/ArticleListItem.astro";
import { profile } from "../../config/profile";
import CVLayout from "../../layouts/CVLayout.astro";
import { languageFromPath } from "../../lib/i18n";
const lang = languageFromPath(Astro.url.pathname);
const koreanDescription = "장르나 분류 상관없이 그때그때 쓰고 싶은 글들을 끄적입니다. 어느날 걷다가 문득 떠오른 생각들과 긴 시간을 연구한 분야에 관한 글, 의식의 흐름을 따라가다가 나온 아이디어들 모두가 존재하는 공간";

const articles = (await getCollection("articles", ({ data }) => !data.draft && data.language === lang))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const groups = articles.reduce((years, article) => {
  const year = article.data.publishedAt.getUTCFullYear();
  const existing = years.get(year) ?? [];
  existing.push(article);
  years.set(year, existing);
  return years;
}, new Map<number, typeof articles>());
---

<CVLayout
  page="articles"
  title={lang === "ko" ? "게시글 — 한호진" : `Articles — ${profile.name}`}
  description={lang === "ko" ? koreanDescription : "Research notes and essays on security, AI, provenance, and software systems."}
>
  <header class="archive-header">
    <h1>{lang === "ko" ? "게시글" : "Articles"}</h1>
    <p>{lang === "ko" ? koreanDescription : "Research notes and essays on security, artificial intelligence, provenance, and software systems."}</p>
  </header>

  <div class="year-groups">
    {articles.length === 0 && <p class="empty-state">{lang === "ko" ? "아직 등록된 한글 게시글이 없습니다." : "No English articles have been published yet."}</p>}
    {Array.from(groups).map(([year, yearArticles]) => (
      <section aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <div class="article-list">{yearArticles.map((article) => <ArticleListItem {article} />)}</div>
      </section>
    ))}
  </div>
</CVLayout>

<style>
  .archive-header { margin-bottom: 3.75rem; }
  .archive-header h1 { font-size: 1.75rem; font-weight: 550; letter-spacing: -0.025em; line-height: 1.25; margin: 0; }
  .archive-header p { color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.65; margin: 0.625rem 0 0; max-width: 34rem; }
  .year-groups { display: grid; gap: 4.25rem; }
  .year-groups section > h2 { color: var(--color-text-secondary); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; line-height: 1.4; margin: 0 0 var(--space-6); }

  @media (max-width: 760px) {
    .archive-header h1 { font-size: 1.875rem; }
    .archive-header p { font-size: 1rem; }
    .year-groups section > h2 { font-size: 0.8125rem; }
  }
</style>
